# BELL Personal 開發設定：複製成 .env 後重新啟動 npm run dev。
# 只有 npm run dev / npm start 會讀 .env（--env-file-if-exists）；正式環境使用
# ~/.config/bell-personal/environment（見 deployment/environment.example）。
# 不設定任何值也能完整啟動：需要憑證的來源會顯示「尚未設定」。

# API 監聽位址與連接埠；網頁開發伺服器固定 4330（vite.config.ts）。
# BELLPERSONAL_HOST=127.0.0.1
# BELLPERSONAL_PORT=4331
# BELLPERSONAL_FRONTEND_PORT=4330

# 額外允許的精確 HTTP(S) origin，以逗號分隔（最多 32 個）；不可有路徑、萬用字元或帳密。
# BELLPERSONAL_ALLOWED_ORIGINS=https://<your-tailnet-host>:20003

# 允許開啟頁面的 Tailscale 登入名稱；留空時開發環境不檢查身分，正式環境則拒絕啟動。
# BELLPERSONAL_TAILSCALE_USERS=alice@github

# 資料與憑證位置（相對路徑以啟動目錄為準；兩者都已列在 .gitignore）。
# BELLPERSONAL_DATA_DIR=data
# BELLPERSONAL_SECRETS_DIR=.secrets

# 加密連線憑證用的主金鑰（32 位元組 base64）。未設定時 Google、Moodle、Canvas 等
# 需要憑證的來源無法連線，其餘功能照常。產生方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BELLPERSONAL_MASTER_KEY=

# 選填：Google OAuth 用戶端（也可以在「連線與設定」輸入，加密保存）。
# BELLPERSONAL_GOOGLE_CLIENT_ID=
# BELLPERSONAL_GOOGLE_CLIENT_SECRET=

# 「今天」的時區；主機時鐘是 UTC。
# BELLPERSONAL_TZ=Asia/Taipei

# 同時執行的模型 CLI 行程（1–32）與逾時倍率（0.5–10）。
# BELLPERSONAL_MAX_AGENT_PROCESSES=1
# BELLPERSONAL_AGENT_TIMEOUT_SCALE=1

# 停止服務時等待進行中 AI 工作的秒數（0–13）。
# BELLPERSONAL_DRAIN_SECONDS=10

# 只供開發：GET /api/today 改回傳這個示範檔（正式環境拒絕啟動）。
# BELLPERSONAL_TODAY_FIXTURE=server/fixtures/today-2026-10-12.json

# 關閉 JSON 行記錄（測試時使用）。
# BELLPERSONAL_LOG=off

# CLI 不在 PATH 時指定完整路徑。BELL 只使用 CLI 本身的登入，從不讀取其憑證。
# CLAUDE_CLI_PATH=/home/you/.local/bin/claude
# CODEX_CLI_PATH=/home/you/.local/bin/codex
# GH_CLI_PATH=/usr/bin/gh

# BELL Suite（選填，兩者分開設定）。瀏覽器連結：切換器、深連結、交接與回程用的姊妹 app 位址，
# 每筆 app=origin，逗號分隔：loopback 可用 http，其他必須是同一個 tailnet 的 https *.ts.net。
# BELLPERSONAL_SUITE_LINKS=explain=http://127.0.0.1:21101
# 伺服器讀取：只讀姊妹的 GET /api/suite/today，只接受 http 加 IP 字面值 loopback（不收 localhost）。
# BELLPERSONAL_SUITE_FETCH=explain=http://127.0.0.1:21101
