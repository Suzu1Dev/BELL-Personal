{
  "name": "bell-personal",
  "version": "1.0.1",
  "description": "Local-first daily workspace for tasks, inbox, calendar, ideas, and habits — standalone or part of BELL Suite.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suzu1Dev/BELL-Personal.git"
  },
  "homepage": "https://github.com/Suzu1Dev/BELL-Personal#readme",
  "bin": {
    "bell-personal": "./bin/bell-personal.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "!server/**/*.test.ts",
    "shared",
    "!shared/**/*.test.ts",
    "src/styles/tokens.css",
    "LICENSE",
    "README.md",
    "README.zh-TW.md",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "prepare": "node -e \"import('node:fs').then(fs=>{if(fs.existsSync('node_modules/vite')&&!fs.existsSync('dist/index.html'))import('node:child_process').then(cp=>cp.execSync('npm run build',{stdio:'inherit'}))})\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "BELLPERSONAL_LOG=off tsx --import ./test/css-stub.mjs --test --test-timeout=120000 \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@googleapis/calendar": "20.0.1",
    "@googleapis/gmail": "22.0.1",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "fast-xml-parser": "5.12.0",
    "google-auth-library": "11.1.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "^0.468.0",
    "node-ical": "0.27.2",
    "postcss": "8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "2.18.1",
    "tsx": "^4.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-popover": "1.3.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "^5.0.0",
    "cmdk": "1.1.1",
    "concurrently": "^9.2.5",
    "motion": "14.6.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.8"
  }
}
